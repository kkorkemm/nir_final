<Window x:Class="nir2.Windows.MethodArgumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:nir2.Windows"
        mc:Ignorable="d"
        Title="Аргументы для операции" Height="350" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TextName"
                   Text="Аргументы для операции: "
                   Margin="10"
                   FontSize="15"
                   FontWeight="SemiBold"/>

        <DataGrid Grid.Row="1"
                  Margin="10"
                  x:Name="GridArguments"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  BorderBrush="LightGray"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название"
                                    Width="*"
                                    Binding="{Binding Name}"/>
                <DataGridComboBoxColumn Header="Тип данных"
                                        Width="*"
                                        x:Name="ComboTypes"
                                        SelectedItemBinding="{Binding dataType}"/>
                <DataGridCheckBoxColumn Header="Это коллекция?"
                                        Binding="{Binding IsCollection}"
                                        Width="*"/>
            </DataGrid.Columns>
            
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Margin="10"
                    Orientation="Horizontal">
            <Button x:Name="BtnSave"
                    Click="BtnSave_Click"
                    Content="Сохранить"
                    Padding="5"
                    Width="100"
                    Margin="0 0 10 0"/>
            <Button x:Name="BtnCancel"
                    Click="BtnCancel_Click"
                    Content="Отмена"
                    Padding="5"
                    Width="100"
                    Margin="0 0 10 0"/>
        </StackPanel>
        
    </Grid>
</Window>
