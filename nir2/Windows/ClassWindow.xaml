<Window x:Class="nir2.Windows.ClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:nir2.Windows"
        xmlns:l="clr-namespace:nir2.Entities"
        mc:Ignorable="d"
        Title="Добавить новый класс" Height="550" Width="750"
        MinHeight="300" MinWidth="520"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="15">

            <TextBlock Text="Название класса"/>
            <TextBox Text="{Binding Name}"/>

            <StackPanel Margin="0 10 0 0"
                        Orientation="Horizontal">
                <RadioButton x:Name="radioInterface"
                             Content="Интерфейс"
                             Margin="0 0 10 0"
                             VerticalAlignment="Center"
                             Checked="radioInterface_Checked"/>
                <RadioButton x:Name="radioStatic"
                             Content="Статический класс"
                             Margin="0 0 10 0"
                             VerticalAlignment="Center"
                             Checked="radioInterface_Checked"/>
                <RadioButton x:Name="radioAbstract"
                             Content="Абстрактный класс"
                             Margin="0 0 10 0"
                             VerticalAlignment="Center"
                             Checked="radioInterface_Checked"/>
                <Button x:Name="BtnClear"
                        Content="Очистить ограничения"
                        VerticalAlignment="Center"
                        Margin="0 0 10 0"
                        Padding="5"
                        Click="BtnClear_Click"
                        Visibility="Hidden"/>
            </StackPanel>
            
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="15 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Атрибуты"
                       FontSize="14"
                       FontWeight="DemiBold"
                       Margin="0 5"/>

            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      x:Name="GridAttributes"
                      CanUserAddRows="True"
                      CanUserDeleteRows="True"
                      BorderBrush="LightGray">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Width="*" Binding="{Binding Name}"/>

                    <DataGridComboBoxColumn Header="Тип данных" SelectedItemBinding="{Binding dataType}" Width="*" x:Name="comboAttrTypes">
                        <!--<DataGridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type l:DataType}">
                                <x:Static Member="l:DataType.String" />
                                <x:Static Member="l:DataType.Integer" />
                                <x:Static Member="l:DataType.Boolean" />
                                <x:Static Member="l:DataType.Real" />
                                <x:Static Member="l:DataType.UnlimitedNatural" />
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>-->
                    </DataGridComboBoxColumn>

                    <DataGridCheckBoxColumn Header="Хранит коллекцию"
                                            Binding="{Binding IsCollection}"
                                            Width="*"/>

                    <DataGridComboBoxColumn Header="Модификатор доступа" SelectedItemBinding="{Binding accessType}" Width="*">
                        <DataGridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type l:AccessType}">
                                <x:Static Member="l:AccessType.Public" />
                                <x:Static Member="l:AccessType.Protected" />
                                <x:Static Member="l:AccessType.Private" />
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>
                    </DataGridComboBoxColumn>

                    <DataGridTextColumn Header="Кратность" Width="*" Binding="{Binding Multiplicity}"/>
                    <DataGridComboBoxColumn Header="Ограничения" Width="*" SelectedItemBinding="{Binding Constraint}">
                        <DataGridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type l:ConstraintType}">
                                <x:Static Member="l:ConstraintType.Static" />
                                <x:Static Member="l:ConstraintType.readOnly" />
                                <x:Static Member="l:ConstraintType.notNull" />
                                <x:Static Member="l:ConstraintType.required" />
                                <!--<x:Static Member="l:ConstraintType.unique" />
                                <x:Static Member="l:ConstraintType.Abstract" />
                                <x:Static Member="l:ConstraintType.Virtual" />
                                <x:Static Member="l:ConstraintType.ordered" />
                                <x:Static Member="l:ConstraintType.sequence" />-->
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>
                    </DataGridComboBoxColumn>

                    <DataGridTextColumn Header="Значение по умолчанию" Width="*" Binding="{Binding defaultValue}"/>

                </DataGrid.Columns>
                
            </DataGrid>
            
        </Grid>

        <Grid Grid.Row="2"
              Margin="15 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Операции"
                       FontSize="14"
                       FontWeight="DemiBold"
                       Margin="0 5"/>

            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      x:Name="GridMethods"
                      CanUserAddRows="True"
                      CanUserDeleteRows="True"
                      BorderBrush="LightGray">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Width="*" Binding="{Binding Name}"/>

                    <DataGridComboBoxColumn Header="Тип возращаемого значения" SelectedItemBinding="{Binding dataType}" Width="*" x:Name="comboMethodTypes">
                        <!--<DataGridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type l:DataType}">
                                <x:Static Member="l:DataType.Void"/>
                                <x:Static Member="l:DataType.String" />
                                <x:Static Member="l:DataType.Integer" />
                                <x:Static Member="l:DataType.Boolean" />
                                <x:Static Member="l:DataType.Real" />
                                <x:Static Member="l:DataType.UnlimitedNatural" />
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>-->
                    </DataGridComboBoxColumn>

                    <DataGridCheckBoxColumn Header="Возвращает коллекцию"
                                            Binding="{Binding IsCollection}"
                                            Width="*"/>

                    <DataGridComboBoxColumn Header="Модификатор доступа" SelectedItemBinding="{Binding accessType}" Width="*">
                        <DataGridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type l:AccessType}">
                                <x:Static Member="l:AccessType.Public" />
                                <x:Static Member="l:AccessType.Protected" />
                                <x:Static Member="l:AccessType.Private" />
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>
                    </DataGridComboBoxColumn>

                    <DataGridComboBoxColumn Header="Ограничения" Width="*" SelectedItemBinding="{Binding Constraint}">
                        <DataGridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type l:ConstraintType}">
                                <x:Static Member="l:ConstraintType.Static" />
                                <x:Static Member="l:ConstraintType.Abstract" />
                                <x:Static Member="l:ConstraintType.Virtual" />
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>
                    </DataGridComboBoxColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="BtnAddArgument"
                                        Content="Добавить аргумент"
                                        Click="BtnAddArgument_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

            </DataGrid>

        </Grid>

        <StackPanel Margin="15" Orientation="Horizontal"
                    Grid.Row="3">
            <Button x:Name="BtnSave"
                    Content="Сохранить"
                    Padding="5"
                    Width="150"
                    Margin="0 0 10 0"
                    Click="BtnSave_Click"/>

            <Button x:Name="BtnDelete"
                    Content="Удалить"
                    Click="BtnDelete_Click"
                    Width="150"
                    Margin="0 0 10 0"
                    Padding="5"
                    IsEnabled="False"/>

            <Button x:Name="BtnCancel"
                    Content="Отмена"
                    Padding="5"
                    Width="150"
                    Click="BtnCancel_Click"/>
        </StackPanel>
        
    </Grid>
</Window>
